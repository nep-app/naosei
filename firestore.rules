rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA FIRESTORE — projeto PRÓPRIO do fórum "naosei".
// Projeto separado da NEP App: aqui só vive o fórum anónimo.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/naosei_moderators/$(request.auth.uid));
    }

    // ---- Perfil (alcunha + bio + "o que te traz aqui") ----
    match /naosei_profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && request.resource.data.alias is string
        && request.resource.data.alias.size() <= 24
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
        && (!('reason' in request.resource.data) || (request.resource.data.reason is string && request.resource.data.reason.size() <= 40));
    }

    // ---- Espaço pessoal (privado do dono): guardados, notificações, etc. ----
    match /naosei_users/{userId}/{collectionId}/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ---- Publicações do fórum ----
    match /naosei_forum_posts/{postId} {
      allow read: if isSignedIn();
      // Criar: como próprio autor. O canal "avisos" só aceita moderadores.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000
        && (request.resource.data.theme != 'avisos' || isModerator());
      // Editar (autor) ou fixar/gerir (moderador). Título/corpo continuam limitados.
      allow update: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid || isModerator())
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000
        && request.resource.data.authorUid == resource.data.authorUid;
      // Apagar: autor ou moderador.
      allow delete: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid || isModerator());

      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 3000;
        allow update: if isSignedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid;
        allow delete: if isSignedIn()
          && (resource.data.authorUid == request.auth.uid || isModerator());
      }
    }

    // ---- Denúncias ----
    match /naosei_forum_reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    // ---- Lista de moderadores ----
    match /naosei_moderators/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Votos de "apoio" ----
    match /naosei_forum_votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- Avisos / notificações (atividade) ----
    // Cada evento é dirigido ao dono do conteúdo (forUid) e só ele o lê.
    // Quem cria tem de ser o próprio ator (actorUid). "Guardar" não revela a alcunha.
    match /naosei_activity/{id} {
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.forUid == request.auth.uid;
      allow update: if false;
    }

    // ---- Mensagens privadas (DMs) ----
    // Só os 2 participantes leem/escrevem. Bloquear alguém impede-o de te escrever.
    match /naosei_dms/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        function conv() { return get(/databases/$(database)/documents/naosei_dms/$(convId)).data; }
        function recipient() {
          return conv().participants[0] == request.auth.uid ? conv().participants[1] : conv().participants[0];
        }
        allow read: if isSignedIn() && request.auth.uid in conv().participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in conv().participants
          && !exists(/databases/$(database)/documents/naosei_users/$(recipient())/blocks/$(request.auth.uid));
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
        allow update: if false;
      }
    }

    // ---- Negar tudo o resto ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
