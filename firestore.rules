rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA FIRESTORE — projeto PRÓPRIO do fórum "naosei".
// Projeto separado da NEP App: aqui só vive o fórum anónimo (e nada da app).
//
// Regra base: só quem tem sessão iniciada participa. As publicações são LIDAS por
// qualquer pessoa autenticada (é um fórum), mas cada um só cria/apaga o que é seu.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // Moderador = tem um documento em naosei_moderators/{uid} (criado na consola Firebase).
    function isModerator() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/naosei_moderators/$(request.auth.uid));
    }

    // ---- Perfil do fórum (alcunha) ----
    // Cada pessoa gere o seu; leitura permitida a quem tem sessão
    // (só contém a alcunha pública, nunca o email/nome real).
    match /naosei_profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId)
        && request.resource.data.alias is string
        && request.resource.data.alias.size() <= 24;
    }

    // ---- Registo pessoal (PRIVADO do dono), caso venha a existir ----
    match /naosei_users/{userId}/{collectionId}/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ---- Publicações do fórum (PARTILHADAS, anónimas) ----
    // Leitura: qualquer pessoa autenticada. Criar: só como próprio autor.
    match /naosei_forum_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 140
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 5000;
      // Apagar: o autor OU um moderador.
      allow delete: if isSignedIn()
        && (resource.data.authorUid == request.auth.uid || isModerator());
      allow update: if false;

      // Respostas (anónimas).
      match /replies/{replyId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 3000;
        allow delete: if isSignedIn()
          && (resource.data.authorUid == request.auth.uid || isModerator());
        allow update: if false;
      }
    }

    // ---- Denúncias ----
    // Qualquer pessoa autenticada pode CRIAR uma denúncia (como próprio autor).
    // Ler/gerir: só moderadores.
    match /naosei_forum_reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    // ---- Lista de moderadores ----
    // Leitura permitida a autenticados; escrita só pela consola/admin.
    match /naosei_moderators/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Votos de "apoio" (positivos) ----
    // Um por pessoa por publicação. Cada pessoa só cria/apaga o SEU voto.
    match /naosei_forum_votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- Negar tudo o resto ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
